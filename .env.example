# Copy this file to .env for local development and fill in your own values.
# Never commit .env. In the cloud, set these in the platform's environment settings.

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts (jsonwebtoken format, e.g. 2h, 30m)
JWT_EXPIRES_IN=2h

# From your GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must exactly match the "Authorization callback URL" in the GitHub OAuth App
# Local:  http://localhost:3000/auth/github/callback
# Render: https://YOUR-APP.onrender.com/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Only set this when you run React on the Vite dev server (npm run dev:client),
# then use http://localhost:5173. Leave it empty otherwise, including in the cloud.
CLIENT_URL=

# SQLite file location
DB_PATH=./data/capsules.db

PORT=3000
